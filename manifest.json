{
  "manifest_version": 3,
  "name": "Teletalk Jobs Filler",
  "short_name": "Teletalk Filler",
  "version": "1.1.2",
  "description": "Smartly autofills Bangladesh Government Job application forms on *.teletalk.com.bd with multi-profile support and JSON backup.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.teletalk.com.bd/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Teletalk Jobs Filler",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.teletalk.com.bd/*"
      ],
      "js": [
        "filler.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
